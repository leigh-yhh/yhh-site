# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars).
# Production: npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON
#
# Paste the entire service-account JSON on one line (or keep newlines; Wrangler accepts either).

GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"yhh-drive-upload@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Also set in wrangler.toml [vars] or here for local override:
GDRIVE_PARENT_FOLDER_ID=
# GDRIVE_IMPERSONATE_USER=
