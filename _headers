# workers.dev is a preview host. The custom domain does not match these rules, so it stays indexable.
https://:project.:account.workers.dev/*
	X-Robots-Tag: noindex

https://:version.:project.:account.workers.dev/*
	X-Robots-Tag: noindex

/images/*
	Cache-Control: public, max-age=2592000

/styles.css
	Cache-Control: public, max-age=86400

/*.js
	Cache-Control: public, max-age=86400

/favicon.svg
	Cache-Control: public, max-age=2592000
